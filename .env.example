# PostgreSQL Connection URL
# Example: postgresql://user:password@host:port/database
POSTGRES_URL="postgresql://iedc_user:iedc_password@localhost:5432/iedc_db"

# Base URL for the application (used for server-side API calls)
# For local development, this is usually http://localhost:3000
# For production, set this to your production domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudinary URL (if used for image uploads, not strictly for seeding static URLs)
# CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Other environment specific variables can go here
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Note: For local development, create a .env.local file and copy these variables,
# then replace with your actual credentials. DO NOT commit .env.local or .env files with sensitive data.
# .env.local is ignored by default by Next.js .gitignore settings.
# If you created a root .gitignore earlier, ensure .env and .env*local are listed.
# (They are in the .gitignore I created earlier)
